{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/lib/financing/**/*.ts"],
  "exclude": ["src/lib/financing/**/__tests__/**"]
}
